{
  "upstreams": [
    {
      "id": "github-tools",
      "url": "https://mcp.platform.acme.com/mcp",
      "namespace": "gh",
      "owner": { "org": "acme-platform", "team": "devex" },
      "auth": { "strategy": "token-exchange", "tokenEndpoint": "https://acme.okta.com/oauth2/v1/token", "clientId": "fold-gateway", "clientAuth": { "type": "client_secret_post", "secretRef": "FOLD_OKTA_SECRET" }, "audience": "https://mcp.platform.acme.com" }
    },
    {
      "id": "ml-search",
      "urls": ["https://mcp-1.ml.acquired-co.com/mcp", "https://mcp-2.ml.acquired-co.com/mcp"],
      "namespace": "search",
      "owner": { "org": "acquired-co", "team": "ml" },
      "auth": { "strategy": "static", "secretRef": "ML_SEARCH_API_KEY", "header": "x-api-key", "scheme": "" },
      "rateLimit": { "requestsPerMinute": 600 },
      "circuitBreaker": { "failureThreshold": 5, "halfOpenAfterMs": 30000 },
      "healthCheck": { "intervalMs": 30000 }
    }
  ],
  "auth": {
    "mode": "required",
    "resource": "https://gw.example.com",
    "issuers": [
      { "issuer": "https://acme.okta.com", "groupsClaim": "groups" }
    ]
  },
  "policy": {
    "defaultDecision": "deny",
    "rules": [
      {
        "id": "eng-github",
        "subjects": { "groups": ["engineering"] },
        "allow": [
          { "server": "github-tools", "methods": ["tools/call"], "names": ["get_*", "create_pr"] },
          { "server": "ml-search" }
        ]
      }
    ]
  },
  "audit": {
    "sinks": [ { "type": "stdout" } ]
  },
  "tenants": [
    {
      "id": "acquired-co",
      "subjects": { "issuers": ["https://acme.okta.com"], "claims": { "org_id": "acquired-co" } },
      "budget": { "period": "month", "upstreamCalls": 500000 },
      "rateLimit": { "requestsPerMinute": 2000 },
      "upstreams": ["ml-search"]
    }
  ],
  "server": {
    "allowedHosts": ["gw.example.com"],
    "rateLimit": { "requestsPerMinute": 6000 },
    "console": { "enabled": true }
  },
  "tracing": {
    "otlpEndpoint": "http://otel-collector:4318"
  }
}
