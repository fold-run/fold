{
  "title": "fold \u2014 gateway overview",
  "uid": "fold-overview",
  "tags": [
    "fold",
    "mcp",
    "gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "fold, the enterprise MCP gateway. Metric names are frozen by fold's v1 compatibility contract, so these queries keep working across upgrades. Alert rules and SLO definitions ship alongside: docs/operations.md.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service level",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (28d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.995
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - (sum(increase(fold_requests_total{outcome=~\"error|upstream_down\"}[28d])) / clamp_min(sum(increase(fold_requests_total[28d])), 1))",
          "legendFormat": "availability",
          "range": true,
          "refId": "B"
        }
      ],
      "description": "Requests fold did not fail, over 28 days. Denials, rate limits, and exhausted budgets are excluded on purpose: those are the gateway working as configured, not an outage. SLO 99.9% \u2014 see docs/operations.md."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget left (28d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "1 - ((sum(increase(fold_requests_total{outcome=~\"error|upstream_down\"}[28d])) / clamp_min(sum(increase(fold_requests_total[28d])), 1)) / 0.001)",
          "legendFormat": "budget",
          "range": true,
          "refId": "C"
        }
      ],
      "description": "Fraction of the 99.9% SLO's error budget still unspent this window. Negative means spent."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 14,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(fold_requests_total[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "D"
        }
      ],
      "description": "Every MCP request through the gateway. Refusal outcomes (denied, rate_limited, budget_exhausted) are governance, not failure \u2014 watch their shape, not their presence."
    },
    {
      "id": 5,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fold_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fold_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fold_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "G"
        }
      ],
      "description": "End to end, which includes the upstream's own time. Compare with the panel to its right before concluding the gateway is slow."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gateway overhead (approximate)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fold_request_duration_seconds_bucket[5m]))) - histogram_quantile(0.95, sum by (le) (rate(fold_upstream_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 request - p95 upstream",
          "range": true,
          "refId": "H"
        }
      ],
      "description": "The difference between the two histograms' p95s. Approximate, and honest about it: quantiles do not subtract, and one federated list fans out to many upstream calls, so this over-reads on list-heavy traffic. The exact number is the CI latency gate (docs/benchmarks.md); this is the production shape."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Upstreams",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Circuit breaker state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "fold_upstream_breaker_state",
          "legendFormat": "{{upstream}}",
          "range": true,
          "refId": "I"
        }
      ],
      "description": "0 closed, 1 half-open, 2 open. Sustained 2 means fold has stopped trying that upstream \u2014 the alert fires at 5 minutes."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream call outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (upstream, outcome) (rate(fold_upstream_requests_total[5m]))",
          "legendFormat": "{{upstream}} {{outcome}}",
          "range": true,
          "refId": "J"
        }
      ],
      "description": "A JSON-RPC error from an upstream counts as ok: the upstream answered, and its error passes through verbatim. connect_error and circuit_open are the ones that mean trouble."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Endpoint rotation",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "fold_upstream_endpoint_healthy",
          "legendFormat": "{{upstream}} {{endpoint}}",
          "range": true,
          "refId": "K"
        }
      ],
      "description": "Multi-endpoint upstreams only: 1 in rotation, 0 ejected after a connect failure or an active probe."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Upstream calls per request",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fold_request_upstream_calls_bucket[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "L"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fold_request_upstream_calls_bucket[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "M"
        }
      ],
      "description": "What one client request really costs. A named call is 1; the tail is the width of the federation, because a list fans out to every upstream."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Upstream duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(fold_upstream_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{upstream}}",
          "range": true,
          "refId": "N"
        }
      ],
      "description": "Per upstream, so a slow federation member is attributable rather than averaged away."
    },
    {
      "id": 14,
      "type": "row",
      "title": "Governance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Top tenants by consumption",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, sum by (tenant) (rate(fold_tenant_upstream_calls_total[5m])))",
          "legendFormat": "{{tenant}}",
          "range": true,
          "refId": "O"
        }
      ],
      "description": "Upstream invocations per tenant \u2014 the same unit tenants[].budget is charged in, so this is an allowance being spent. Empty unless tenants are declared."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Tenant refusals",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (tenant, outcome) (rate(fold_tenant_requests_total{outcome!=\"ok\"}[5m]))",
          "legendFormat": "{{tenant}} {{outcome}}",
          "range": true,
          "refId": "P"
        }
      ],
      "description": "Why a customer is being refused, split by mechanism: denied is policy or the visibility subset, rate_limited is a bucket, budget_exhausted is the allowance. Three different owners \u2014 a rule, a limit, and a conversation."
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Budget decisions without shared state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (scope) (rate(fold_budget_degraded_total[5m]))",
          "legendFormat": "{{scope}}",
          "range": true,
          "refId": "Q"
        }
      ],
      "description": "Non-zero means Redis was unreachable and each instance is enforcing its own copy of an allowance, so a fleet of N enforces N budgets. Fail-open is deliberate; silent is not."
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Audit delivery",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 6
      },
      "description": "Audit is the single exit door, and this is the one failure the trail cannot record about itself. delivered is the healthy line; retried means a receiver is stumbling; dead_lettered means events were written to a file for replay instead of delivered; dropped means they are gone \u2014 a full buffer, or a give-up with no deadLetterPath configured.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (sink, outcome) (rate(fold_audit_events_total[5m]))",
          "legendFormat": "{{sink}} {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Context reduction",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 6
      },
      "description": "What fraction of the upstreams' catalogue each caller actually receives, after per-principal policy filtering. This is fold's structural answer to context bloat, with no model in the loop \u2014 a low number is the feature working, not a fault.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
